APP_NAME="MiniStore"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_MARKETING_URL=https://example.com
# Optional. Set this to your own domain (e.g. example.com) to also serve every store at
# storename.example.com in addition to example.com/storename. Requires a wildcard DNS record
# (*.example.com) and a wildcard SSL certificate pointed at this server — leave blank until both
# are in place. Both URL forms keep working once this is set; nothing is forced to redirect.
APP_ROOT_DOMAIN=
APP_KEY=replace-with-a-random-64-character-secret
APP_TIMEZONE=UTC

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ministore
DB_USERNAME=ministore_user
DB_PASSWORD=change-me

SESSION_NAME=ministore_session
SESSION_LIFETIME=120
SESSION_SECURE=true
TRUSTED_PROXY_IPS=
ANALYTICS_RETENTION_DAYS=730
MAIL_FROM=no-reply@example.com
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
BILLING_PROVIDER=manual
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=7
BILLING_MANUAL_PERIOD_DAYS=30

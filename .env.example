# Copy to .env and fill in. .env is gitignored — never commit real values.

# Local development, via docker compose up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5432/drphone

# Production: use the pooled connection string from your provider (Neon,
# Supabase), not the direct one — serverless functions exhaust direct
# connections. Prefer an EU region: it is the closest low-latency option to
# Lebanon.

# Google One Tap. Create an OAuth 2.0 Client ID (type: Web application) at
# console.cloud.google.com — free. Add your origin to "Authorized JavaScript
# origins". Leave unset and Google sign-in is simply hidden.
GOOGLE_CLIENT_ID=

# Mail. `console` prints verification codes to the server log instead of
# sending them, so registration works before you pick a provider.
MAIL_TRANSPORT=console
MAIL_FROM=DRPHONE <no-reply@example.com>

# Where product images are stored. Only "local" exists today: it writes to
# public/uploads, which is fine for development and wrong for production —
# serverless filesystems are read-only at runtime and wiped on every deploy.
# Pick a provider before uploading a real catalog; the admin shows a warning
# until one is set. Adding a driver means one file in src/lib/storage/.
STORAGE_DRIVER=local

# Shared secret for the scheduled-job endpoints (currently
# /api/cron/expire-reservations, which releases expired cart stock holds).
# Generate with: openssl rand -base64 32
# The endpoints return 503 rather than running unauthenticated when this is
# unset — an open sweeper endpoint would let anyone strip the holds off every
# live cart. Suggested schedule: every five minutes.
CRON_SECRET=

# Brevo, for MAIL_TRANSPORT=brevo. Free tier is 300 emails a day, which covers
# verification codes and password resets for a shop this size. Get a key from
# Brevo > SMTP & API > API keys, and verify the MAIL_FROM domain with them or
# they will refuse the message.
BREVO_API_KEY=

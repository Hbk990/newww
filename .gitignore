node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Secrets — DATABASE_URL and friends. Never commit.
.env
.env.local
.env*.local

# Local dev database cluster
.devdb/

.DS_Store
npm-debug.log*

# Uploaded product images. The local driver writes here; production uses a
# bucket, and committing a catalog of photos would bloat the repo.
/public/uploads/

# Playwright output. Traces and screenshots from a failed run are for looking
# at locally, not for keeping.
/test-results/
/playwright-report/
/blob-report/

# Per-machine Claude Code permission grants, written automatically. The shared
# hook config in .claude/settings.json is committed; this one is personal.
.claude/settings.local.json

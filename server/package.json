{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-client.mjs && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/ensure-client.mjs && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && node scripts/ensure-client.mjs",
    "db:push": "prisma db push",
    "generate": "prisma generate",
    "seed:vpic": "tsx prisma/seed-vpic.ts",
    "seed:demo": "node scripts/ensure-client.mjs && tsx prisma/seed-demo.ts",
    "seed:large": "node scripts/ensure-client.mjs && tsx prisma/seed-large.ts",
    "create:user": "node scripts/ensure-client.mjs && tsx scripts/create-user.ts",
    "reset:2fa": "node scripts/ensure-client.mjs && tsx scripts/reset-2fa.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "ensure:cashbox": "tsx scripts/ensure-cash-box.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.41.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.5",
    "mysql2": "^3.12.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
